# Public URL of the site (used for sitemap, canonical and hreflang links)
NEXT_PUBLIC_SITE_URL=https://www.mth-halle.de

# SMTP account that sends the inquiry e-mails (ask the company's IT / mail provider)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false          # true for port 465
SMTP_USER=website@mth-halle.de
SMTP_PASS=change-me

# Sender and recipients
MAIL_FROM="MTH Website <website@mth-halle.de>"
MAIL_TO=info@mth-halle.de

# Local testing only: log the e-mail to the console instead of sending it
# MAIL_DRY_RUN=1
